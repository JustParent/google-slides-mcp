# Copy to .env (or set these in your MCP client config) and fill in.
#
# Auth uses a standard interactive OAuth 2.0 installed-app flow: one shared Desktop
# OAuth client JSON, and each person logs in once in a browser to cache their own
# personal token. The GOOGLE_* names and the shorter aliases below are
# interchangeable.

# Path to the OAuth client secret JSON downloaded from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID -> Desktop app).
# Alias: CREDENTIALS_PATH (GOOGLE_CLIENT_SECRET wins if both are set).
GOOGLE_CLIENT_SECRET=/absolute/path/to/client_secret.json
# CREDENTIALS_PATH=/absolute/path/to/credentials.json

# Where this user's cached OAuth token is stored after login. Must be writable.
# Defaults to ~/.config/google-slides-mcp/token.json if unset.
# Alias: TOKEN_PATH (GOOGLE_TOKEN_PATH wins if both are set).
GOOGLE_TOKEN_PATH=~/.config/google-slides-mcp/token.json
# TOKEN_PATH=token.json

# Optional: comma-separated override of OAuth scopes. Defaults to
# presentations + drive. Only change if you know you need narrower access.
# GOOGLE_SLIDES_SCOPES=https://www.googleapis.com/auth/presentations,https://www.googleapis.com/auth/drive

# Optional: set to 1 to disable the automatic browser consent flow on first
# server launch (e.g. headless/server deploys). Then log in beforehand with the
# google-slides-mcp-auth command.
# GOOGLE_SLIDES_NO_BROWSER_AUTH=1
